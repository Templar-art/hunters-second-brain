{
  "_about": "Tasteful (v6, after Hunter: 'too much SFX, especially on interior shots'): whooshes only where the film changes zone (outside/inside/aerial) or the camera moves; nothing on static interior cuts; no interior ambience; quieter. Aerial wind bed off until a recorded wind exists (synthetic wind rejected 28 Oct).",
  "rules": {
    "min_score": 0.4,
    "whoosh_requires_sync": true,
    "riser_min_rise_db": 7.0,
    "impact_on_synced_cuts": false,
    "max_tail_s": {
      "whoosh": 1.2,
      "impact": 2.5,
      "shimmer": 1.5
    },
    "motion_whoosh_min": 0.5,
    "whoosh_on_scene_changes_only": true,
    "scene_change_weight": 0.2
  },
  "limits": {
    "min_spacing_s": 2.5,
    "total_per_minute": 13,
    "per_minute": {
      "whoosh": 9,
      "impact": 3,
      "riser": 2,
      "shimmer": 1,
      "low drone": 1,
      "ambience": 1
    },
    "max_whoosh_share_of_cuts": 0.22,
    "max_overlap": 2
  },
  "levels": {
    "relative_db": {
      "whoosh": -13,
      "riser": -12,
      "impact": -8,
      "shimmer": -14,
      "low drone": -18,
      "ambience": -20
    },
    "peak_ceiling_dbfs": {
      "whoosh": -14,
      "riser": -12,
      "impact": -8,
      "shimmer": -16,
      "low drone": -20,
      "ambience": -22
    }
  },
  "fades": {
    "trim_fade_out": 0.35
  },
  "scenes": {
    "skip_tags": [
      "interior",
      "aerial"
    ],
    "relative_db": {
      "outdoor": -15,
      "aerial": -14,
      "dusk": -15
    },
    "prefer_recorded": true
  }
}