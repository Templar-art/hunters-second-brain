{%- comment -%}
  Email sign-up pop-up with a first-order code. Shopify's own customer form, so every sign-up lands in
  Customers with marketing consent and the tags below. Once per visitor (vx.js), never on cart or password pages.
{%- endcomment -%}
{%- if section.settings.enabled and template.name != 'cart' and template.name != 'password' -%}
<dialog class="vx vx-pop" data-vx-popup data-delay="{{ section.settings.delay }}" data-days="{{ section.settings.snooze_days }}" aria-labelledby="vx-pop-title">
  <div class="vx-pop__inner">
    {%- if section.settings.image -%}<figure class="vx-pop__media">{{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 760px) 360px, 100vw', alt: '' }}</figure>{%- endif -%}
    <div class="vx-pop__body">
      <button type="button" class="vx-icon vx-pop__close" data-vx-popup-close aria-label="Close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
      {%- form 'customer', class: 'vx-pop__form' -%}
        {%- if form.posted_successfully? -%}
          <div data-vx-popup-state="done">
            <h2 id="vx-pop-title" class="vx-pop__title" tabindex="-1" autofocus>{{ section.settings.done_heading }}</h2>
            <p class="vx-pop__text">{{ section.settings.done_text }}</p>
            <p class="vx-pop__code">{{ section.settings.code }}</p>
            <a class="vx-buy vx-pop__btn" href="{{ routes.all_products_collection_url }}">Shop now</a>
          </div>
        {%- else -%}
          <p class="vx-pop__kicker">{{ section.settings.kicker }}</p>
          <h2 id="vx-pop-title" class="vx-pop__title" tabindex="-1" autofocus>{{ section.settings.heading }}</h2>
          <p class="vx-pop__text">{{ section.settings.text }}</p>
          <input type="hidden" name="contact[tags]" value="{{ section.settings.tags | escape }}">
          <input type="hidden" name="contact[accepts_marketing]" value="true">
          <label class="vx-sr" for="vx-pop-email">Email</label>
          <input class="vx-pop__input" id="vx-pop-email" type="email" name="contact[email]" autocomplete="email" placeholder="Email address" required>
          <button class="vx-buy" type="submit">{{ section.settings.button }}</button>
          {%- if form.errors -%}<p class="vx-pop__error" role="alert" data-vx-popup-state="error">That email didn&rsquo;t go through. Check it and try again.</p>{%- endif -%}
          <button type="button" class="vx-pop__skip" data-vx-popup-close>{{ section.settings.decline }}</button>
          <p class="vx-pop__fine">{{ section.settings.fine_print }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</dialog>
{%- endif -%}
{% schema %}
{ "name": "Email pop-up", "settings": [
  { "type": "checkbox", "id": "enabled", "label": "Show the pop-up", "default": true },
  { "type": "range", "id": "delay", "label": "Open after (seconds)", "min": 2, "max": 30, "step": 1, "default": 6 },
  { "type": "range", "id": "snooze_days", "label": "Wait before showing again (days)", "min": 1, "max": 60, "step": 1, "default": 7 },
  { "type": "image_picker", "id": "image", "label": "Photo" },
  { "type": "text", "id": "kicker", "label": "Small line", "default": "Final stock" },
  { "type": "text", "id": "heading", "label": "Heading", "default": "25% off your first order" },
  { "type": "text", "id": "text", "label": "Text", "default": "Join the list for your code. Once this run is gone, it's gone, so grab your size first." },
  { "type": "text", "id": "button", "label": "Button", "default": "Unlock 25% off" },
  { "type": "text", "id": "decline", "label": "Decline link", "default": "No thanks, I'll pay full price" },
  { "type": "text", "id": "fine_print", "label": "Fine print", "default": "One use per customer. Unsubscribe any time." },
  { "type": "text", "id": "tags", "label": "Customer tags", "default": "newsletter, welcome-popup" },
  { "type": "text", "id": "code", "label": "Code shown after sign-up", "default": "BEBITA25" },
  { "type": "text", "id": "done_heading", "label": "Thank-you heading", "default": "You're in. Here's 25% off." },
  { "type": "text", "id": "done_text", "label": "Thank-you text", "default": "Use this code at checkout on your first order." } ] }
{% endschema %}
