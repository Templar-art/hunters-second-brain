{%- comment -%} Full-bleed hero. One panel, or two side by side on desktop (the second hides on phones). {%- endcomment -%}
<div class="vx vx-heroes{% if section.settings.image_2 != blank %} vx-heroes--split{% endif %}">
  {%- for i in (1..2) -%}
    {%- liquid
      if i == 1
        assign img = section.settings.image
        assign title = section.settings.title
        assign sub = section.settings.sub
        assign link = section.settings.link
      else
        assign img = section.settings.image_2
        assign title = section.settings.title_2
        assign sub = section.settings.sub_2
        assign link = section.settings.link_2
      endif
    -%}
    {%- if img != blank -%}
      <a class="vx-hero" href="{{ link | default: routes.all_products_collection_url }}">
        {%- if i == 1 -%}{%- assign load = 'eager' -%}{%- else -%}{%- assign load = 'lazy' -%}{%- endif -%}
        {{ img | image_url: width: 2000 | image_tag: loading: load, widths: '600, 900, 1200, 1600, 2000', sizes: '(min-width: 990px) 50vw, 100vw', alt: title }}
        <div class="vx-hero__text"><h2 class="vx-hero__title">{{ title }}</h2>{%- if sub != blank -%}<p class="vx-hero__sub">{{ sub }}</p>{%- endif -%}</div>
      </a>
    {%- endif -%}
  {%- endfor -%}
</div>
{% schema %}
{ "name": "Hero", "settings": [
  { "type": "image_picker", "id": "image", "label": "Image" },
  { "type": "text", "id": "title", "label": "Heading", "default": "Shop Active" },
  { "type": "text", "id": "sub", "label": "Small line" },
  { "type": "url", "id": "link", "label": "Link" },
  { "type": "header", "content": "Second panel (desktop)" },
  { "type": "image_picker", "id": "image_2", "label": "Image" },
  { "type": "text", "id": "title_2", "label": "Heading", "default": "Shop Swim" },
  { "type": "text", "id": "sub_2", "label": "Small line" },
  { "type": "url", "id": "link_2", "label": "Link" } ],
  "presets": [{ "name": "Hero" }] }
{% endschema %}
