{%- liquid
  assign threshold = section.settings.free_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  assign progress = cart.total_price | times: 100 | divided_by: threshold
  if progress > 100
    assign progress = 100
  endif

  assign has_top = false
  assign has_bottom = false
  assign lines = ''
  for item in cart.items
    if item.product.tags contains 'top'
      assign has_top = true
    endif
    if item.product.tags contains 'bottom'
      assign has_bottom = true
    endif
    if item.product.tags contains 'swim'
      assign lines = lines | append: 'swim,'
    else
      assign lines = lines | append: 'active,'
    endif
  endfor

  comment
    The upsell. A top with no bottom (or the reverse) gets its partner piece, preselected in the same colour.
    A full set gets the other line instead.
  endcomment
  assign offer = nil
  assign offer_colour = ''
  assign offer_heading = ''
  if cart.item_count > 0
    for item in cart.items
      assign is_top = false
      if item.product.tags contains 'top'
        assign is_top = true
      endif
      if is_top and has_bottom
        continue
      endif
      unless is_top
        if has_top
          continue
        endif
      endunless
      assign pool = section.settings.bottoms.products
      if is_top == false
        assign pool = section.settings.tops.products
      endif
      assign word = item.product.title | split: ' ' | first
      for p in pool
        assign pw = p.title | split: ' ' | first
        if pw == word and p.available
          assign offer = p
          break
        endif
      endfor
      if offer
        for o in item.options_with_values
          assign on = o.name | downcase
          if on contains 'colo'
            assign offer_colour = o.value
          endif
        endfor
        if is_top
          assign offer_heading = section.settings.need_bottom
        else
          assign offer_heading = section.settings.need_top
        endif
        break
      endif
    endfor
  endif

  assign other_line = 'swim'
  if lines contains 'swim'
    assign other_line = 'active'
  endif
  if lines contains 'swim' and lines contains 'active'
    assign other_line = ''
  endif
-%}

<section class="bb bb-cart" aria-labelledby="bb-cart-title">
  <div class="bb-cart__head">
    <h1 id="bb-cart-title" class="bb-cart__title">{{ section.settings.heading }}</h1>
    {%- if cart.item_count > 0 -%}<p class="bb-cart__count">{{ cart.item_count }} {% if cart.item_count == 1 %}piece{% else %}pieces{% endif %}</p>{%- endif -%}
  </div>

  {%- if cart.item_count > 0 -%}
    <div class="bb-ship" role="status">
      <p>
        {%- if remaining > 0 -%}
          You&rsquo;re <strong>{{ remaining | money }}</strong> away from free delivery.
        {%- else -%}
          <strong>Free delivery</strong> is on this order.
        {%- endif -%}
      </p>
      <div class="bb-ship__track" aria-hidden="true"><span style="width: {{ progress }}%"></span></div>
    </div>

    <div class="bb-cart__layout">
      <ul class="bb-cart__lines" role="list">
        {%- for item in cart.items -%}
          <li class="bb-line-item">
            <a class="bb-line-item__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
              {%- if item.image -%}{{ item.image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 400', sizes: '120px', alt: '' }}{%- endif -%}
            </a>
            <div class="bb-line-item__info">
              <a class="bb-line-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <p class="bb-line-item__opts">{% for o in item.options_with_values %}{{ o.value }}{% unless forloop.last %} · {% endunless %}{% endfor %}</p>
              {%- endunless -%}
              <div class="bb-qty" aria-label="Quantity for {{ item.product.title | escape }}">
                <a class="bb-qty__btn" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity={{ item.quantity | minus: 1 }}" aria-label="One fewer">&minus;</a>
                <span class="bb-qty__n">{{ item.quantity }}</span>
                <a class="bb-qty__btn" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity={{ item.quantity | plus: 1 }}" aria-label="One more">+</a>
                <a class="bb-line-item__remove" href="{{ item.url_to_remove }}">Remove</a>
              </div>
            </div>
            <p class="bb-line-item__price">
              {{ item.final_line_price | money }}
              {%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}
            </p>
          </li>
        {%- endfor -%}
      </ul>

      <aside class="bb-cart__side">
        {%- if offer -%}
          {%- liquid
            assign oi = -1
            assign si = -1
            for opt in offer.options
              assign on = opt | downcase
              if on contains 'colo'
                assign oi = forloop.index0
              elsif on contains 'size'
                assign si = forloop.index0
              endif
            endfor
            assign shown = offer.featured_image
            for v in offer.variants
              if oi >= 0 and v.options[oi] == offer_colour and v.featured_image
                assign shown = v.featured_image
                break
              endif
            endfor
          -%}
          <form class="bb-upsell" action="{{ routes.cart_add_url }}" method="post">
            <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
            <p class="bb-upsell__label">{{ offer_heading }}</p>
            <div class="bb-upsell__card">
              {%- if shown -%}{{ shown | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 400', sizes: '120px', alt: offer.title }}{%- endif -%}
              <div>
                <p class="bb-upsell__title">{{ offer.title }}</p>
                <p class="bb-upsell__meta">{% if offer_colour != blank %}{{ offer_colour }} · {% endif %}{{ offer.price | money }}</p>
              </div>
            </div>
            <fieldset class="bb-option">
              <legend>Your size</legend>
              <div class="bb-chips">
                {%- for v in offer.variants -%}
                  {%- if oi < 0 or v.options[oi] == offer_colour -%}
                    <label class="bb-chip"{% unless v.available %} data-soldout{% endunless %}>
                      <input type="radio" class="visually-hidden" name="id" value="{{ v.id }}" required {% unless v.available %}disabled{% endunless %}>
                      <span>{% if si >= 0 %}{{ v.options[si] }}{% else %}{{ v.title }}{% endif %}{% unless v.available %}<span class="visually-hidden">, sold out</span>{% endunless %}</span>
                    </label>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </fieldset>
            <button class="bb-pill bb-pill--static" type="submit">Add to my set</button>
          </form>
        {%- elsif other_line != blank -%}
          {%- assign cross = collections[other_line].products -%}
          {%- if cross.size > 0 -%}
            <div class="bb-upsell">
              {%- if other_line == 'swim' -%}<p class="bb-upsell__label">{{ section.settings.cross_swim }}</p>{%- else -%}<p class="bb-upsell__label">{{ section.settings.cross_active }}</p>{%- endif -%}
              <ul class="bb-upsell__list" role="list">
                {%- for p in cross limit: 2 -%}
                  <li><a class="bb-upsell__card" href="{{ p.url }}">
                    {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 400', sizes: '120px', alt: '' }}{%- endif -%}
                    <div><p class="bb-upsell__title">{{ p.title }}</p><p class="bb-upsell__meta">{{ p.price | money }}</p></div>
                  </a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endif -%}

        <form class="bb-cart__summary" action="{{ routes.cart_url }}" method="post">
          <p class="bb-cart__subtotal"><span>Subtotal</span> <strong>{{ cart.total_price | money }}</strong></p>
          <p class="bb-cart__note">Delivery is worked out at checkout: {{ section.settings.delivery_note }}</p>
          <button class="bb-pill bb-pill--static bb-cart__checkout" type="submit" name="checkout">Checkout</button>
          <ul class="bb-cart__promise" role="list">
            <li>Sent from the Gold Coast</li>
            <li>Easy size swaps</li>
            <li>30-day returns on unworn pieces</li>
          </ul>
        </form>
      </aside>
    </div>
  {%- else -%}
    <div class="bb-cart__empty">
      <p>Your bag is empty.</p>
      <div class="bb-cart__empty-links">
        <a class="bb-pill bb-pill--static" href="{{ routes.root_url }}#picker">Build your set</a>
        <a class="bb-arrow" href="/collections/active">Shop Active</a>
        <a class="bb-arrow" href="/collections/swim">Shop Swim</a>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Bebita bag",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your bag" },
    { "type": "number", "id": "free_threshold", "label": "Free delivery from ($)", "default": 100 },
    { "type": "text", "id": "delivery_note", "label": "Delivery note", "default": "$9.95 standard, free over $100, Express $14.95." },
    { "type": "text", "id": "need_bottom", "label": "Upsell heading when the bag has a top only", "default": "Complete the set" },
    { "type": "text", "id": "need_top", "label": "Upsell heading when the bag has a bottom only", "default": "Complete the set" },
    { "type": "text", "id": "cross_swim", "label": "Cross-sell heading (to Swim)", "default": "Beach next?" },
    { "type": "text", "id": "cross_active", "label": "Cross-sell heading (to Active)", "default": "Gym next?" },
    { "type": "collection", "id": "tops", "label": "Tops collection" },
    { "type": "collection", "id": "bottoms", "label": "Bottoms collection" }
  ]
}
{% endschema %}
