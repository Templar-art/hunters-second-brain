<section class="bb bb-promise" aria-label="Delivery and returns">
  <ul role="list">
    {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}><strong>{{ block.settings.title }}</strong> {{ block.settings.text }}</li>{%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Bebita promise strip",
  "max_blocks": 4,
  "blocks": [{ "type": "item", "name": "Item", "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Sent from the Gold Coast" },
    { "type": "text", "id": "text", "label": "Text", "default": "Packed and posted by us" }
  ] }],
  "presets": [{ "name": "Bebita promise strip" }]
}
{% endschema %}
