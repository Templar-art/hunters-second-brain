{%- comment -%} One product as compact JSON for the set picker: role (top/bottom), line (active/swim), options, variants. {%- endcomment -%}
{%- liquid
  assign role = 'other'
  if product.tags contains 'top'
    assign role = 'top'
  elsif product.tags contains 'bottom'
    assign role = 'bottom'
  endif
  assign line = 'active'
  if product.tags contains 'swim'
    assign line = 'swim'
  endif
-%}
{"id":{{ product.id }},"title":{{ product.title | json }},"handle":{{ product.handle | json }},"url":{{ product.url | json }},"role":{{ role | json }},"line":{{ line | json }},
"image":{{ product.featured_image | image_url: width: 1200 | json }},
"options":[{%- for o in product.options_with_values -%}{"name":{{ o.name | json }},"values":{{ o.values | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}],
"variants":[{%- for v in product.variants -%}{"id":{{ v.id }},"options":{{ v.options | json }},"price":{{ v.price }},"available":{{ v.available }},"left":{% if v.inventory_management == 'shopify' %}{{ v.inventory_quantity }}{% else %}null{% endif %},"image":{% if v.featured_image %}{{ v.featured_image | image_url: width: 1200 | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]}
