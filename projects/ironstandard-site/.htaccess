# Apache / LiteSpeed hosts (cPanel). Upload with the site into public_html.
ErrorDocument 404 /404.html
DirectoryIndex index.html

<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(jpg|jpeg|png|css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Old WordPress URLs go home
  RewriteRule ^(wp-|index\.php) / [L,R=301]
  # Cookies and accessibility now live inside the privacy and terms pages
  RewriteRule ^cookies\.html$ /privacy.html#cookies [NE,L,R=301]
  RewriteRule ^accessibility\.html$ /terms.html#accessibility [NE,L,R=301]
  # Keep the Apps Script source off the public site
  RewriteRule ^google-apps-script/ - [F,L]
</IfModule>
