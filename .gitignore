# Obsidian local/workspace state (machine-specific, not for syncing)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json
.obsidian/cache
.trash/

# OS
.DS_Store

# brainstorming companion scratch
.superpowers/

# client render frames — kept local (CVA asset, ~28MB); regenerate via README
projects/10x-scroll-build/frames/
projects/10x-scroll-salisbury/frames/
projects/10x-scroll-salisbury/*.mp4
projects/10x-scroll-salisbury/**/*.mp4
projects/10x-scroll-salisbury/**/*.jpg
projects/10x-scroll-salisbury/**/*.png
projects/10x-scroll-salisbury/camtests/
projects/10x-scroll-salisbury/flystory/
projects/aios-dashboard/logs/

# invoice configs contain bank details (BSB + account no.) — keep local
projects/elevra-invoices/invoices/

# bespoke pop-ups: ProRes 4444 alpha masters are ~60-90MB each, regenerate via tools/render-sequence.mjs
projects/bespoke-sold-popups/preview/*.mov
projects/bespoke-sold-popups/preview/frames/

# impeccable detector cache
**/.impeccable/hook.cache.json

# CLC sprint PNG exports — derived, regenerate with canvas/export_png.py
projects/clc-graphic-sprint-sep-2026/exports/
projects/clc-graphic-sprint-sep-2026/canvas/__pycache__/

# Bebita Instagram rips (hundreds of MB of images; kept local, not in git)
raw/bebita/instagram-*/
projects/committed-coaching/**/*.mp4

# B-roll frames (regenerated from source clips with tools/broll.py)
projects/*/episodes/*/broll/

# raw client footage (large; lives on disk, not in git)
projects/*/footage/

# Blender working files (100s of MB; GitHub rejects >100 MB). Kept on disk, not in git.
*.blend1
projects/blender-blockouts/beach-house-v1.blend
projects/blender-blockouts/cliff-mansion-v2.blend

# Global media rule (2026-10-19): video/audio/Blender/zip never go into git — .git hit 6.6 GB.
# Finals live on Drive/SSD; the wiki points at them. Already-tracked files stay tracked
# (ignore rules don't untrack). To force one small file in: git add -f <file>
*.mp4
*.mov
*.m4v
*.mxf
*.wav
*.aif
*.aiff
*.mp3
*.blend
*.zip

# Blender kit build renders (regenerate with build.py; the compare sheet + report.json stay tracked)
projects/**/build/guides/
projects/**/build/id/

# kollosche gulls: plate frames, renders, comps and masters regenerate from scripts/
projects/extra-salt-kollosche-birds/frames/
projects/extra-salt-kollosche-birds/comp/
projects/extra-salt-kollosche-birds/render/
projects/extra-salt-kollosche-birds/src/
projects/extra-salt-kollosche-birds/out/*.mov
projects/extra-salt-kollosche-birds/*.blend1
projects/extra-salt-kollosche-birds/track.log

# plate-vfx: benchmark/job frames, renders, comps, outputs regenerate from plate_vfx.py
projects/plate-vfx/bench/*/frames/
projects/plate-vfx/bench/*/render/
projects/plate-vfx/bench/*/comp/
projects/plate-vfx/bench/*/out/
projects/plate-vfx/bench/*/src/
projects/plate-vfx/**/__pycache__/
projects/plate-vfx/assets/skies/*.hdr
projects/plate-vfx/bench/*/sky/
projects/sky-library/hdr_*/
projects/sky-library/renders/
projects/sky-library/renders_away/
